        "# Создаем фигуру с 3 графиками в ряд\n",
        "fig, axs = plt.subplots(figsize=(16, 4), ncols=3)\n",
        "\n",
        "# Перебираем степени полинома для демонстрации переобучения\n",
        "for i, degree in enumerate([1, 5, 15]):\n",
        "\n",
        "    # Генерируем полиномиальные признаки\n",
        "    X_polynom = PolynomialFeatures(degree).fit_transform(X_school_scaled)\n",
        "\n",
        "    # Обучаем модель линейной регрессии на полиномиальных признаках\n",
