        "\n",
        "    # Делаем предсказания\n",
        "    y_pred = regr.predict(X_polynom)\n",
        "\n",
        "    # сортировка для корректного отображения линии\n",
        "    idx = np.argsort(X_school_scaled[:,0])\n",
