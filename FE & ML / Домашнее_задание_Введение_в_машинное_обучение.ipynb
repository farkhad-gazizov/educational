        ")\n",
        "\n",
        "# Создаем область для трех графиков\n",
        "fig, axs = plt.subplots(figsize=(18, 5), ncols=3)\n",
        "\n",
        "# Сравниваем модели с разными степенями полинома\n",
        "for i, degree in enumerate([1, 5, 15]):\n",
        "\n",
        "    # Создаем объект для полиномизации признака\n",
        "    poly = PolynomialFeatures(degree=degree)\n",
        "\n",
        "    # Формируем полиномиальные признаки для train и test\n",
        "    X_train_poly = poly.fit_transform(X_train)\n",
        "    X_test_poly = poly.transform(X_test)\n",
        "\n",
        "    # Создаем и обучаем модель линейной регрессии\n",
        "    model = LinearRegression()\n",
        "    model.fit(X_train_poly, y_train)\n",
        "\n",
        "    # Получаем прогноз на тестовой выборке\n",
        "    y_pred_test = model.predict(X_test_poly)\n",
        "\n",
        "    # Вычисляем метрики качества модели\n",
        "    mse = mean_squared_error(y_test, y_pred_test)\n",
        "    r2 = model.score(X_test_poly, y_test)\n",
        "\n",
        "    # Выводим результаты в консоль\n",
        "    print(\n",
        "        f\"Степень {degree}: \"\n",
        "        f\"MSE = {mse:.3f}, \"\n",
        "        f\"R² = {r2:.3f}\"\n",
        "    )\n",
        "\n",
        "    # Строим прогноз для всей выборки (для визуализации)\n",
        "    X_all_poly = poly.transform(X_school_scaled)\n",
        "    y_pred_all = model.predict(X_all_poly)\n",
        "\n",
        "    # Сортируем точки по Schooling для корректного отображения линии\n",
        "    idx = np.argsort(X_school_scaled[:, 0])\n",
        "\n",
        "    # Отображаем реальные данные\n",
        "    axs[i].scatter(\n",
        "        X_school_scaled[:, 0],\n",
        "        y,\n",
        "        alpha=0.4,\n",
        "        label='Данные'\n",
        "    )\n",
        "\n",
        "    # Отображаем аппроксимирующую кривую модели\n",
        "    axs[i].plot(\n",
        "        X_school_scaled[idx, 0],\n",
        "        y_pred_all[idx],\n",
        "        color='red',\n",
        "        linewidth=3,\n",
        "        label='Модель'\n",
        "    )\n",
        "\n",
        "    # Заголовок графика с указанием степени полинома и метрик\n",
        "    axs[i].set_title(\n",
        "        f'Степень = {degree}\\n'\n",
        "        f'MSE = {mse:.2f}, R² = {r2:.3f}'\n",
        "    )\n",
        "\n",
        "    # Подписи осей\n",
        "    axs[i].set_xlabel('Schooling (scaled)')\n",
        "    axs[i].set_ylabel('Life expectancy')\n",
        "\n",
        "    # Добавляем легенду\n",
        "    axs[i].legend()\n",
        "\n",
        "    # Фиксируем диапазон оси Y для удобного сравнения графиков\n",
        "    axs[i].set_ylim(30, 100)\n",
        "\n",
        "# Автоматически подгоняем отступы между графиками\n",
        "plt.tight_layout()\n",
        "\n",
        "# Отображаем графики\n",
        "plt.show()\n",
        "\n"
      ],
